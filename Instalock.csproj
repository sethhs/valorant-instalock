<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Instalock</AssemblyName>
    <RootNamespace>Instalock</RootNamespace>
    <Version>1.0.1</Version>
    <Product>Instalock</Product>
    <Description>Agent select helper for VALORANT: cursor assist or Riot client API lock.</Description>
    <Copyright>Copyright (c) 2026 Instalock contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

  </PropertyGroup>
  <ItemGroup>
    <Resource Include="icons\*.png" />
    <Resource Include="icon.ico" />
  </ItemGroup>
</Project>
