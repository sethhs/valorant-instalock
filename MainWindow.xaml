<Window x:Class="Instalock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalock" Width="920" Height="720"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Body}" Icon="icon.ico"
        WindowStyle="None" ResizeMode="CanMinimize" StateChanged="Window_StateChanged"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="72" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border x:Name="Root" Width="920" Height="720" BorderBrush="#1C1C1C" BorderThickness="1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="32,20,14,14">
      <StackPanel Orientation="Horizontal">
        <Image Source="icons/app.png" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Instalock" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Caps}" Text="AUTO AGENT SELECT  ·  F8 TO STOP"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="16" Padding="14,7" Margin="0,0,12,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Dim}" Margin="0,0,9,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Caps}" FontSize="12" Text="IDLE"/>
          </StackPanel>
        </Border>
        <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
          <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconMin}" Width="15" Height="15"
                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <Button Style="{StaticResource CloseButton}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True">
          <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconClose}" Width="15" Height="15"
                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="32,0,32,14" Height="36">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="250"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="Filter_Changed"/>
      <StackPanel x:Name="RoleChips" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
        <RadioButton Style="{StaticResource RoleChip}" Tag="All" IsChecked="True" Checked="Filter_Changed"/>
        <RadioButton Style="{StaticResource RoleChip}" Tag="Initiator" Checked="Filter_Changed"/>
        <RadioButton Style="{StaticResource RoleChip}" Tag="Duelist" Checked="Filter_Changed"/>
        <RadioButton Style="{StaticResource RoleChip}" Tag="Sentinel" Checked="Filter_Changed"/>
        <RadioButton Style="{StaticResource RoleChip}" Tag="Controller" Checked="Filter_Changed"/>
      </StackPanel>
    </Grid>

    <Grid x:Name="GridHost" Grid.Row="2" Margin="32,0,32,0" SizeChanged="GridHost_SizeChanged" ClipToBounds="True">
      <TextBlock x:Name="LoadingText" Style="{StaticResource Caps}" FontSize="14" Text="LOADING AGENTS..."/>
      <ItemsControl x:Name="AgentList" HorizontalAlignment="Center" VerticalAlignment="Top">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Loaded="TilePanel_Loaded"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding Shown, Converter={StaticResource BoolToVis}}"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton Style="{StaticResource AgentTile}" Checked="Agent_Checked"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Border Grid.Row="3" Background="#111111" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="16" Margin="24,14,24,24">
      <Grid Margin="14,12,14,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,0,14,0">
            <Grid>
              <ContentControl x:Name="PickedPlaceholder" Style="{StaticResource Icon}" Tag="{StaticResource IconUser}" Width="20" Height="20"
                              Foreground="{StaticResource Dim}"/>
              <Image x:Name="PickedIcon" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Caps}" Text="SELECTED"/>
            <TextBlock x:Name="PickedText" Text="None" Style="{StaticResource Title}" FontSize="20"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
          <TextBlock Style="{StaticResource Caps}" Text="MODE" Margin="2,0,0,4"/>
          <Border x:Name="ModeChips" Background="#0A0A0A" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="9" Padding="3">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="CursorMode" Style="{StaticResource Segment}" IsChecked="True" Checked="Mode_Changed">
                <StackPanel Orientation="Horizontal">
                  <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconPointer}" Width="14" Height="14" Margin="0,0,8,0"
                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                  <TextBlock Text="CURSOR ASSIST" VerticalAlignment="Center"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ApiMode" Style="{StaticResource Segment}" Checked="Mode_Changed">
                <StackPanel Orientation="Horizontal">
                  <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconZap}" Width="14" Height="14" Margin="0,0,8,0"
                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                  <TextBlock Text="API" VerticalAlignment="Center"/>
                  <Border Background="#33FF4655" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="RISKY" FontSize="10" Foreground="{StaticResource Red}"/>
                  </Border>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
        </StackPanel>
        <Button x:Name="ToggleButton" Grid.Column="2" Style="{StaticResource LockButton}" HorizontalAlignment="Right" MinWidth="180"
                IsEnabled="False" Click="Toggle_Click">
          <StackPanel Orientation="Horizontal">
            <ContentControl x:Name="ToggleIcon" Style="{StaticResource Icon}" Tag="{StaticResource IconLock}" Width="19" Height="19" Margin="0,-1,10,0"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock x:Name="ToggleText" Text="LOCK IN" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
